{
  "name": "vite-react-typescript-starter",
  "private": true,
  "description": "A web project for LearnMates educational platform.",
  "author": "LearnMates Team",
  "homepage": "https://www.learnmates.org",
  "keywords": [
    "learnmates",
    "education",
    "react",
    "vite",
    "typescript",
    "web"
  ],
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate-metadata": "node script/generateMetadata.js",
    "generate:manifests": "node scripts/generateQuizManifests.js",
    "copy:pdfjs": "node scripts/copyPdfJsAssets.js",
    "upload:blob": "node scripts/uploadToBlob.js",
    "prebuild": "npm run generate:manifests && npm run copy:pdfjs",
    "build": "npm run generate-metadata && vite build && npm run generate-sitemap",
    "generate-sitemap": "node script/sitemap.js",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@formspree/react": "^3.0.0",
    "@icon-park/svg": "^1.4.2",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/blob": "^2.0.0",
    "dropbox": "^10.34.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.344.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.296",
    "phosphor-react": "^1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-helmet-async": "^2.0.5",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.7.1",
    "sitemap": "^8.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "remotion": "^4.0.484",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.1.7"
  }
}
